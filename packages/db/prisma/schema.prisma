// Database schema. Migrations: `npm run db:migrate` (local), `prisma migrate deploy` (prod, CI).
// Auth tables (User, Session, Account, Verification) follow Better Auth's core schema;
// keep their fields in sync with `npx @better-auth/cli generate` when upgrading better-auth.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Better Auth ----------

model User {
  id              String            @id
  name            String
  email           String            @unique
  emailVerified   Boolean           @default(false)
  image           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        Session[]
  accounts        Account[]
  household       HouseholdUser?
  favorites       ProductFavorite[]
  recipeFavorites RecipeFavorite[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------- Household ----------

/// One family. Every domain table (products, recipes, …) will reference it.
model Household {
  id            String             @id @default(cuid())
  name          String
  /// Bumped on every write to the household's data; clients poll it to know when to refetch.
  revision      Int                @default(0)
  createdAt     DateTime           @default(now()) @map("created_at")
  users         HouseholdUser[]
  invites       HouseholdInvite[]
  members       FamilyMember[]
  products      Product[]
  productStates HouseholdProduct[]
  recipes       Recipe[]
  recipeStates  HouseholdRecipe[]
  cooking       CookingSession[]
  meals         Meal[]

  @@map("household")
}

enum HouseholdRole {
  owner
  member

  @@map("household_role")
}

/// Which household an account belongs to. One account — one household.
/// The owner manages access (invites, removing accounts); everyone edits data.
model HouseholdUser {
  userId      String        @id @map("user_id")
  householdId String        @map("household_id")
  role        HouseholdRole @default(member)
  createdAt   DateTime      @default(now()) @map("created_at")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_user")
}

/// Invite link/code to join a household. One active invite per household; reusable until the owner revokes it
/// or replaces it with a new code. `expires_at` is legacy (invites used to last 7 days) and is ignored.
model HouseholdInvite {
  code        String    @id
  householdId String    @map("household_id")
  createdById String    @map("created_by_id")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_invite")
}

// ---------- Family ----------

enum Sex {
  male
  female

  @@map("sex")
}

/// A person whose nutrition is tracked (not an account: kids have profiles without accounts).
/// Deleting archives (`archived_at`) so consumption history keeps its member.
model FamilyMember {
  id           String        @id @default(cuid())
  householdId  String        @map("household_id")
  name         String
  sex          Sex
  color        String
  /// Legacy: the norm at creation, no longer read (norms live in `member_norm`). Drop in a later migration.
  kcal         Float
  protein      Float
  fat          Float
  carbs        Float
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  archivedAt   DateTime?     @map("archived_at")
  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  consumptions Consumption[]
  norms        MemberNorm[]
  weights      MemberWeight[]

  @@index([householdId])
  @@map("family_member")
}

/// A member's daily norm in effect from `date` until the next record; at most one per day.
/// A date before the first record uses the first one.
model MemberNorm {
  memberId  String       @map("member_id")
  date      DateTime     @db.Date
  kcal      Float
  protein   Float
  fat       Float
  carbs     Float
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, date])
  @@map("member_norm")
}

/// A member's body weight on `date`, kilograms; at most one per day.
model MemberWeight {
  memberId  String       @map("member_id")
  date      DateTime     @db.Date
  kg        Float
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, date])
  @@map("member_weight")
}

// ---------- Products ----------

enum ProductCategory {
  meat
  fish
  dairy
  eggs
  vegetables
  fruits
  grains
  bakery
  legumes
  nuts
  oils
  sweets
  convenience
  drinks
  other

  @@map("product_category")
}

/// Fast-food chain of a restaurant dish; a product with a restaurant is shown under «Фастфуд», not «Продукты».
enum Restaurant {
  mcdonalds
  kfc
  burgerking
  pizzahut
  other

  @@map("restaurant")
}

/// A product with nutrition per 100 g. `household_id` null = shared catalog row (seeded, stable `cat-…` id);
/// set = the family's own product. Families never change catalog rows: edits go to `household_product.override`.
model Product {
  id          String             @id @default(cuid())
  householdId String?            @map("household_id")
  name        String
  category    ProductCategory
  /// Set = a fast-food dish of this chain (one portion = `units.pieceM`); null = an ordinary product.
  restaurant  Restaurant?
  kcal        Float
  protein     Float
  fat         Float
  carbs       Float
  /// Grams per one unit: `{ ml?, tsp?, tbsp?, pieceS?, pieceM?, pieceL? }` (`ProductUnitsSchema`).
  units       Json               @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  household   Household?         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  states      HouseholdProduct[]
  favorites   ProductFavorite[]
  dishes      MealDish[]

  @@index([householdId])
  @@map("product")
}

/// The family's view of a product: an override of a catalog product (full `ProductDataSchema` copy,
/// null = catalog values) and hiding (null = visible). Applies to every account of the household.
model HouseholdProduct {
  householdId String    @map("household_id")
  productId   String    @map("product_id")
  override    Json?
  hiddenAt    DateTime? @map("hidden_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([householdId, productId])
  @@index([productId])
  @@map("household_product")
}

/// Favorites (♥) belong to an account, not to the household.
model ProductFavorite {
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("product_favorite")
}

// ---------- Recipes ----------

/// A recipe template: products in their units, in display order. `household_id` null = shared catalog recipe
/// (seeded from `prisma/recipes.ts`, stable `rcp-…` id); set = the family's own recipe. Weight and nutrition
/// are not stored: they follow from the products (raw weight = sum of ingredient grams).
model Recipe {
  id          String            @id @default(cuid())
  householdId String?           @map("household_id")
  name        String
  /// `[{ productId, amount, unit }]` (`RecipeItemSchema`).
  items       Json              @default("[]")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  household   Household?        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  states      HouseholdRecipe[]
  favorites   RecipeFavorite[]
  cooking     CookingSession[]
  dishes      MealDish[]

  @@index([householdId])
  @@map("recipe")
}

/// The family's view of a recipe: an override of a catalog recipe (full `RecipeDataSchema` copy,
/// null = catalog values) and hiding (null = visible). Same rules as `household_product`.
model HouseholdRecipe {
  householdId String    @map("household_id")
  recipeId    String    @map("recipe_id")
  override    Json?
  hiddenAt    DateTime? @map("hidden_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([householdId, recipeId])
  @@index([recipeId])
  @@map("household_recipe")
}

/// Recipe favorites (♥) belong to an account.
model RecipeFavorite {
  userId    String   @map("user_id")
  recipeId  String   @map("recipe_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
  @@index([recipeId])
  @@map("recipe_favorite")
}

// ---------- Cooking ----------

/// One real pot cooked on a date. `items` are frozen copies of the products (`CookingItemSchema`), so product
/// edits never change it. Cooked weight = `gross_weight_g − pot_weight_g`; KBJU per 100 g follows from it.
model CookingSession {
  id           String           @id @default(cuid())
  householdId  String           @map("household_id")
  date         DateTime         @db.Date
  name         String
  recipeId     String?          @map("recipe_id")
  recipeScale  Int?             @map("recipe_scale")
  copiedFromId String?          @map("copied_from_id")
  /// `[{ productId, name, nutrients, units, amount, unit }]` (`CookingItemSchema`).
  items        Json             @default("[]")
  potWeightG   Float?           @map("pot_weight_g")
  grossWeightG Float?           @map("gross_weight_g")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  household    Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipe       Recipe?          @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  copiedFrom   CookingSession?  @relation("CookingCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies       CookingSession[] @relation("CookingCopies")
  dishes       MealDish[]

  @@index([householdId, date])
  @@index([recipeId])
  @@map("cooking_session")
}

// ---------- Daily planner ----------

enum MealType {
  breakfast
  lunch
  dinner
  snack

  @@map("meal_type")
}

/// One meal of a day. Stored only while it has dishes (empty breakfast / lunch / dinner are drawn by the app).
model Meal {
  id          String     @id @default(cuid())
  householdId String     @map("household_id")
  date        DateTime   @db.Date
  type        MealType
  createdAt   DateTime   @default(now()) @map("created_at")
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  dishes      MealDish[]

  @@index([householdId, date])
  @@map("meal")
}

/// A dish served in a meal: a frozen copy of a cooking session, a recipe (KBJU per 100 g of its raw ingredients)
/// or a product (KBJU per 100 g, unit weights), so later edits or deletes of the source never change the history.
/// `session_id` / `recipe_id` / `product_id` are kept only to suggest "как в прошлый раз".
model MealDish {
  id           String          @id @default(cuid())
  mealId       String          @map("meal_id")
  position     Int             @default(0)
  sessionId    String?         @map("session_id")
  recipeId     String?         @map("recipe_id")
  productId    String?         @map("product_id")
  /// The product's chain when copied (fast food); null otherwise.
  restaurant   Restaurant?
  name         String
  /// Per 100 g.
  kcal         Float
  protein      Float
  fat          Float
  carbs        Float
  /// Date of the cooking session (null for a recipe or a product).
  sourceDate   DateTime?       @map("source_date") @db.Date
  /// Session: the cooked weight when copied; recipe: one portion (the whole recipe); null for a product.
  weightG      Float?          @map("weight_g")
  /// The session was not weighed yet: per 100 g is of the raw weight.
  rawWeight    Boolean         @default(false) @map("raw_weight")
  /// Grams per unit of the product when copied (`ProductUnitsSchema`); `{}` for sessions and recipes.
  units        Json            @default("{}")
  createdAt    DateTime        @default(now()) @map("created_at")
  meal         Meal            @relation(fields: [mealId], references: [id], onDelete: Cascade)
  session      CookingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  recipe       Recipe?         @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  consumptions Consumption[]

  @@index([mealId])
  @@index([sessionId])
  @@map("meal_dish")
}

/// Grams of a dish eaten by one family member; `amount` + `unit` = how it was entered ("1 шт"), null = grams.
model Consumption {
  id       String       @id @default(cuid())
  dishId   String       @map("dish_id")
  memberId String       @map("member_id")
  grams    Float
  amount   Float?
  unit     String?
  dish     MealDish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  member   FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([dishId, memberId])
  @@index([memberId])
  @@map("consumption")
}
