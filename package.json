{
  "name": "eatandcalc",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start -w @eatandcalc/mobile",
    "dev:api": "npm run dev -w @eatandcalc/api",
    "dev:web": "npm run dev -w @eatandcalc/web",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate:dev -w @eatandcalc/db",
    "db:seed": "npm run seed -w @eatandcalc/db",
    "db:studio": "npm run studio -w @eatandcalc/db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "release:android": "npm run release:android -w @eatandcalc/web",
    "dev": "npm run db:up && concurrently -k -n api,web,mobile -c green,blue,magenta npm:dev:api npm:dev:web npm:dev:mobile",
    "android:dev": "npm run android:dev -w @eatandcalc/mobile",
    "android:sha1": "npm run android:sha1 -w @eatandcalc/mobile"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
