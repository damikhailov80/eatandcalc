# Copy to .env.local. Not secrets: they end up in the app bundle.
# Leave empty in development: the app uses the Metro host IP on port 3000.
EXPO_PUBLIC_API_URL=
# Landing (invite links). Empty in development: the Metro host IP on port 3001.
EXPO_PUBLIC_WEB_URL=
# Google Cloud → OAuth client of type "Web application" (same as GOOGLE_CLIENT_ID in apps/api).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
