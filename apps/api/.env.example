# Copy to .env.local for local development.
DATABASE_URL=postgresql://eatandcalc:eatandcalc@localhost:5434/eatandcalc

# Public URL of this API. Locally localhost is fine: native Google sign-in has no redirects.
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud → OAuth client of type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=first@gmail.com,second@gmail.com
